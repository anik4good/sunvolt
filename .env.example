# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Admin panel credentials
ADMIN_EMAIL=admin@sunvolt.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-random-64-char-hex
# Public site URL (used for sitemap/robots/metadata)
NEXT_PUBLIC_SITE_URL=https://sunvolt.example.com
# Host port for docker compose (container always listens on 3000)
SUNVOLT_PORT=3000
